let global = 10;

let sign = fn(v: u32): u32;

let nothing = fn(v: u32): u32 { v };

let f = fn(
    a: u32,
    b: u32,
): u32 {
    a + b
};

let func = fn(b: bool): u32 {
    if b {
        return 4 as u32;
    };

    5 as u32
};

let main = fn() {
    print("hello world");
    print(func(false));
    
    let v = {
        let x = 5;
        x + x
    };
    print v;

    // uncomment the next line for a syntax error:
    // $
    // uncomment the next line for an ir-gen error:
    // let error = unknown;
    // uncomment one of the next 3 lines for a type error:
    // let n: u32 = "hello";
    // func("hello");
    // let n: []u8 = func(true);
    // func(1, 2);

    print("fib:");
    let mut a = 0 as u64;
    let mut b = 1 as u64;
    loop {
        print(a);
        let tmp = a + b;
        a = b;
        b = tmp;

        if a >= 100000 as u64 {
            break;
        };
        // print("continue");
    };
    // print("done");
};
