let global = 10;

let sign = fn(v: u32): u32;

let nothing = fn(v: u32): u32 { v };

let f = fn(
    a: u32,
    b: u32,
): u32 {
    a + b
};

let func = fn(b: bool): u32 {
    if b {
        return 4 as u32;
    };

    5 as u32
};

let is_isize = fn(v: isize) {};
let is_f64 = fn(v: f64) {};
let is_slice_u8 = fn(v: []u8) {};

let main = fn() {
    print("hello world");
    print(func(if true { false } else { true }));

    let mut pi = 3.14159265;
    print(pi * pi);

    let local_function = fn(v: isize) {
        // `pi` is not accessible from this scope
        // print(pi);
    };
    local_function(5);

    is_isize(0);      // int literals are isize
    is_f64(0.0);      // float literals are f64
    is_slice_u8("0"); // string literals are []u8
    
    let v = {
        let x = 5;
        x + x
    };
    print v;

    if (false) {
        // branches that are known to be unreachable at compile
        // time are not checked (by design (design stolen from Zig))
        let would_error: bool = "hello";
    };

    /*
        multiline
        comments
        also work
    */

    // uncomment the next line for a syntax error:
    // $
    // uncomment one of the next 2 lines for an ir-gen error:
    // let error = unknown;
    // print(x); // `x` is from a closed scope at line 30
    // uncomment one of the next 3 lines for a type error:
    // let n: u32 = "hello";
    // func("hello");
    // let n: []u8 = func(true);
    // func(1, 2);
    // sign(32); // sign is a function type, not a function

    print("fib:");
    let mut a = 0 as u64;
    let mut b = 1 as u64;
    loop {
        print(a);
        let tmp = a + b;
        a = b;
        b = tmp;

        if a >= 100000 as u64 {
            break;
        };
        // print("continue");
    };
    // print("done");
};
