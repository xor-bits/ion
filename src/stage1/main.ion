let global = 10;

let sign = fn(v: u32): u32;

let nothing = fn(v: u32): u32 { v };

let print = fn(s: []u8) {
    let printf = extern fn(s: *u8, ..): c_int @ "printf";
    let res = printf("%.*s\n\x00".ptr, s.len, s.ptr);
};
 
let rand = fn(): c_int {
    let rand = extern fn(): c_int @ "rand";
    rand()
};

let srand = fn() {
    let srand = extern fn(seed: c_uint) @ "srand";
    let time = extern fn(t: usize): u64 @ "time";
    srand(time(0) as c_uint);
};

let sleep = fn(sec: u32) {
    let sleep = extern fn(sec: c_uint): c_uint @ "sleep";
    sleep(sec);
};

let main = fn() {
    let T = u32;
    let mut arr: [4]T = undefined;
    arr[0] = 4;
    
    let a = 5;
    let b = 6;
    print("hello");
    nothing(a + b + global);
    let printf = extern fn(s: *u8, ..): c_int @ "printf";
    srand();
    let num = rand();
    printf("arr[0]: %lu\n\x00".ptr, arr[0]);
    printf("num: %lu\n\x00".ptr, num);
    let mut a = 0 as u64;
    let mut b = 1 as u64;
    loop {
        printf("%u\n\x00".ptr, a);
        let tmp = a + b;
        a = b;
        b = tmp;
        sleep(1);
    }
    print("done");
    let c = 4;
};
